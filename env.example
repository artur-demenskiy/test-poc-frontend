# Analytics Configuration (PostHog)
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_ENVIRONMENT=development
VITE_ANALYTICS_DEBUG=true
VITE_POSTHOG_API_KEY=your_posthog_api_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# Feature Flags Configuration (Unleash)
VITE_FEATURE_FLAGS_ENABLED=true
VITE_FEATURE_FLAGS_DEBUG=true
VITE_UNLEASH_URL=http://localhost:3000/proxy
VITE_UNLEASH_CLIENT_KEY=your_unleash_client_key_here
VITE_UNLEASH_APP_NAME=todo-react-app
VITE_UNLEASH_ENVIRONMENT=development
VITE_UNLEASH_REFRESH_INTERVAL=30000 